DATABASE_URL=postgresql://sparksviu:replace-with-generated-password@db:5432/sparksviu
APP_URL=http://localhost:3000
NODE_ENV=production
# Generate: openssl rand -base64 32. Keep this stable; it encrypts payment destinations and MFA secrets.
ENCRYPTION_KEY=
STORAGE_DIR=/app/storage
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=
# Only enable after legal/privacy text, domain/TLS, SMTP and bank channels are verified.
REGISTRATION_ENABLED=false
POLICIES_APPROVED=false
FLIP_MODE=disabled
PAYOUT_MODE=manual
# Use only with a dedicated synthetic database. UAT closes registration, SMTP and Flip.
UAT_MODE=false
# Temporary password-only login for expiring demo accounts; never enable for real users.
UAT_PASSWORD_ONLY=false
FLIP_API_KEY=
FLIP_CALLBACK_TOKEN=
FLIP_CHANNELS=bca,bri,mandiri
MIN_PAYOUT_IDR=50000
MAX_DAILY_PAYOUT_IDR=500000
PAYOUT_WEEKDAYS=1,2,3,4,5
PAYOUT_HOUR_WIB=10
# Compose database password; URL-safe random hex recommended.
POSTGRES_PASSWORD=
